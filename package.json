{
  "name": "modular-backend-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production-grade modular TypeScript backend reference architecture.",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/workers/worker-app.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/workers/worker-app.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run '**/*.integration.test.ts'",
    "db:migrate": "tsx src/infra/db/migrator.ts up",
    "db:rollback": "tsx src/infra/db/migrator.ts down",
    "worker:outbox": "tsx src/workers/worker-app.ts outbox-publisher",
    "worker:inventory-expire": "tsx src/workers/worker-app.ts inventory-reservation-expirer",
    "conventions:scan": "tsx scripts/convention-scan.ts",
    "arch:check": "dependency-cruiser src --config dependency-cruiser.config.cjs",
    "quality": "pnpm typecheck && pnpm check && pnpm test && pnpm arch:check && pnpm conventions:scan && pnpm build",
    "observability:up": "docker compose -f docker-compose.observability.yml up -d",
    "observability:down": "docker compose -f docker-compose.observability.yml down"
  },
  "dependencies": {
    "@hono/node-server": "2.0.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.218.0",
    "@opentelemetry/resources": "2.7.1",
    "@opentelemetry/sdk-metrics": "2.7.1",
    "@opentelemetry/sdk-node": "0.218.0",
    "@opentelemetry/semantic-conventions": "1.41.1",
    "bullmq": "5.77.1",
    "hono": "4.12.22",
    "ioredis": "5.10.1",
    "kysely": "0.29.2",
    "pg": "8.21.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@testcontainers/postgresql": "12.0.0",
    "@types/node": "25.9.1",
    "@types/pg": "8.20.0",
    "dependency-cruiser": "17.4.2",
    "testcontainers": "12.0.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}
